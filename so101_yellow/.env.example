# Copy this file to .env and fill in real values. .env is gitignored.

HF_USER=your-hf-username
HUGGINGFACE_TOKEN=hf_xxx

# Filled in by scripts/06_record_dataset.sh and scripts/07_train_smolvla.sh / scripts/08_infer_rollout.sh.
# Convention: <hf-username>/yellow_so101_<task-name>
DATASET_REPO_ID=your-hf-username/yellow_so101_pickplace
POLICY_REPO_ID=your-hf-username/yellow_smolvla_pickplace

# Training defaults (overridable per-invocation, see scripts/07_train_smolvla.sh)
BATCH_SIZE=64
STEPS=20000
POLICY_DEVICE=cuda
WANDB_ENABLE=false
