# Fill in after running scripts/04_find_cameras.sh
# Mounted on the end effector (wrist), not a fixed workspace view.
CAM_WRIST_INDEX=0
CAM_WIDTH=1280
CAM_HEIGHT=720
CAM_FPS=30

# GROUND TRUTH — a SECOND, FIXED camera looking down at the workspace.
# REQUIRED for ROBOT_BACKEND=so101. The critic measures pass/fail from
# ArUco markers through this camera, so it must NOT move with the arm:
# a wrist-mounted view makes every marker appear to move when the arm
# moves, and the block's measured position changes without the block
# going anywhere. vision.py refuses to trust it if this is unset or if it
# collides with CAM_WRIST_INDEX.
# Find the index with scripts/04_find_cameras.sh.
CAM_OVERHEAD_INDEX=
